{
  "app": {
    "name": "Grain Quality Analyzer",
    "version": "1.0.0",
    "description": "Grain Quality Analyzer for image-based rice sample quality assessment"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "debug": true,
    "log_level": "INFO"
  },
  "upload": {
    "max_size_mb": 50,
    "allowed_extensions": [".jpg", ".jpeg", ".png", ".webp", ".tiff", ".tif"],
    "upload_dir": "uploads"
  },
  "processing": {
    "max_image_pixels": 100000000,
    "tile_size": 1024,
    "batch_size": 16,
    "use_gpu": true,
    "gpu_device": 0
  },
  "cors": {
    "allowed_origins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  }
}
